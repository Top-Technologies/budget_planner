<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_budget_category_tree" model="ir.ui.view">
        <field name="name">budget.category.tree</field>
        <field name="model">budget.category</field>
        <field name="arch" type="xml">
            <list string="Project Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_stock_sales"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_budget_category_form" model="ir.ui.view">
        <field name="name">budget.category.form</field>
        <field name="model">budget.category</field>
        <field name="arch" type="xml">
            <form string="Project Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Category Name (e.g. Federal Government)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_stock_sales"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_category" model="ir.actions.act_window">
        <field name="name">Project Categories</field>
        <field name="res_model">budget.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create configurable project categories (e.g., Federal Government, Regional Government, NGO, Stock Sales).
            </p>
        </field>
    </record>
</odoo>
