<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_budget_fiscal_year_tree" model="ir.ui.view">
        <field name="name">budget.fiscal.year.tree</field>
        <field name="model">budget.fiscal.year</field>
        <field name="arch" type="xml">
            <list string="Fiscal Years (EFY)">
                <field name="name"/>
                <field name="code"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_budget_fiscal_year_form" model="ir.ui.view">
        <field name="name">budget.fiscal.year.form</field>
        <field name="model">budget.fiscal.year</field>
        <field name="arch" type="xml">
            <form string="Fiscal Year (EFY)">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="EFY 2019 (2026/27)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fiscal Months (M01 - M12)">
                            <field name="month_ids">
                                <list string="Months" editable="bottom">
                                    <field name="month_number"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="local_name"/>
                                    <field name="quarter"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_fiscal_year" model="ir.actions.act_window">
        <field name="name">Fiscal Years (EFY)</field>
        <field name="res_model">budget.fiscal.year</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
