<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Category -->
        <record id="module_category_budget_planner" model="ir.module.category">
            <field name="name">Budget Planner</field>
            <field name="description">Manage Annual Budget &amp; Earnings Plans, Monthly Spreads, and Financial Projections</field>
            <field name="sequence">25</field>
        </record>

        <!-- Privilege (Odoo 19) -->
        <record id="res_groups_privilege_budget_planner" model="res.groups.privilege">
            <field name="name">Budget Planner</field>
            <field name="category_id" ref="module_category_budget_planner"/>
            <field name="sequence">25</field>
        </record>

        <!-- User / Planner -->
        <record id="group_budget_planner_user" model="res.groups">
            <field name="name">Planner</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_budget_planner"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Officer / Reviewer -->
        <record id="group_budget_planner_officer" model="res.groups">
            <field name="name">Finance Reviewer</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_budget_planner"/>
            <field name="implied_ids" eval="[(4, ref('group_budget_planner_user'))]"/>
        </record>

        <!-- Manager / Approver -->
        <record id="group_budget_planner_manager" model="res.groups">
            <field name="name">Budget Manager / Approver</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_budget_planner"/>
            <field name="implied_ids" eval="[(4, ref('group_budget_planner_officer'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
